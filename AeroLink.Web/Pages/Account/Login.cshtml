@page
@model AeroLink.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <h1 class="h3 mb-3">AeroLink sign in</h1>
        <div class="alert alert-warning small">
            Temporary sign-in (stub). Will be replaced by the HR system login.
        </div>

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Name</label>
                <input asp-for="Username" class="form-control" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Sign in</button>
        </form>
    </div>
</div>