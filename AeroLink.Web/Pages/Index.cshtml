@page
@model IndexModel
@{
    ViewData["Title"] = "Main screen";
}

<div class="mt-4 mb-4">
    <h1 class="display-6">Welcome, @User.Identity?.Name</h1>
    <p class="text-muted">Select a module to continue.</p>
</div>

<div class="row g-4">
    <!-- Module 1: Baggage (live) -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-primary">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Baggage Handling</h2>
                <p class="card-text">
                    View flight manifests, verify and load bags, apply special handling and report exceptions.
                </p>
                <a asp-page="/Baggage/Flights" class="btn btn-primary mt-auto">Open</a>
            </div>
        </div>
    </div>

    <!-- Module 2: placeholder (disabled) -->
    <div class="col-md-4">
        <div class="card h-100 bg-light">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title text-muted">Module 2</h2>
                <p class="card-text text-muted">Not part of this prototype.</p>
                <span class="btn btn-secondary disabled mt-auto" aria-disabled="true">Coming soon</span>
            </div>
        </div>
    </div>

    <!-- Module 3: placeholder (disabled) -->
    <div class="col-md-4">
        <div class="card h-100 bg-light">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title text-muted">Module 3</h2>
                <p class="card-text text-muted">Not part of this prototype.</p>
                <span class="btn btn-secondary disabled mt-auto" aria-disabled="true">Coming soon</span>
            </div>
        </div>
    </div>
</div>