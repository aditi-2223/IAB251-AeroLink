@using System.Security.Claims
@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var inBaggage = currentPage.StartsWith("/Baggage");
    var userName = User.Identity?.Name ?? "";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var nameParts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length == 0
        ? "?"
        : string.Concat(nameParts.Take(2).Select(p => char.ToUpper(p[0])));
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AeroLink</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AeroLink.Web.styles.css" asp-append-version="true" />
</head>

<body>
    @if (isSignedIn)
    {
        <div class="app-shell">
            <aside class="app-sidebar">
                <a class="app-logo" asp-area="" asp-page="/Index">Aero<span>Link</span></a>

                <div class="nav-heading">OPERATIONS</div>
                <nav>
                    <span class="nav-item disabled" title="Not part of this prototype">Turnaround Overview</span>
                    <span class="nav-item disabled" title="Not part of this prototype">Resource Allocation</span>
                    <a class="nav-item @(inBaggage ? "active" : "")" asp-area="" asp-page="/Baggage/Flights">Baggage
                        Operations</a>
                        <span class="nav-item disabled" title="Not part of this prototype">Departure Readiness</span>
                    </nav>

                    <div class="nav-heading">REFERENCES</div>
                    <nav>
                        <span class="nav-item disabled" title="Not part of this prototype">Equipment Register</span>
                        <span class="nav-item disabled" title="Not part of this prototype">Staff Roster</span>
                    </nav>
                </aside>

                <div class="app-main">
                    <header class="app-topbar">
                        <div>Brisbane Airport &middot; All Active Turnarounds</div>
                        <div class="user-chip">
                            <span>@role</span>
                            <span class="avatar" title="@userName">@initials</span>
                            <form method="post" asp-page="/Account/Logout" class="m-0">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Log out</button>
                            </form>
                        </div>
                    </header>

                    <main role="main" class="app-content">
                        @RenderBody()
                    </main>
                </div>
            </div>
        }
else
        {
            <header class="public-header">
                <a class="app-logo" asp-area="" asp-page="/Index">Aero<span>Link</span></a>
            </header>
            <div class="container public-main">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        }

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>